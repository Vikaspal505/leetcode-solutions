class Solution {
    public long maxAlternatingSum(int[] nums) {
        int length = nums.length;
        for (int i = 0; i < length; ++i) {
            nums[i] *= nums[i];
        }
        Arrays.sort(nums);
        long answer = 0;
        int half = length / 2;
        for (int i = 0; i < half; ++i) {
            answer -= nums[i];
        }
        for (int i = half; i < length; ++i) {
            answer += nums[i];
        }
        return answer;
    }
}
