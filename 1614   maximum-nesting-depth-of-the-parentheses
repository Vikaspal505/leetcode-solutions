class Solution {
   
    public int maxDepth(String s) {
        int maxDepth = 0;    
        int currentDepth = 0; 
      
        for (int i = 0; i < s.length(); i++) {
            char currentChar = s.charAt(i);
          
            if (currentChar == '(') {
                currentDepth++;
                maxDepth = Math.max(maxDepth, currentDepth);
            } 
            else if (currentChar == ')') {
                currentDepth--;
            }
        }
      
        return maxDepth;
    }
}
