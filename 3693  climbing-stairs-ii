class Solution {
    public int climbStairs(int n, int[] costs) {
        int dp[] = new int[n+1];
        final int  INF  =  Integer.MAX_VALUE/2;
        Arrays.fill(dp,INF);
        dp[0]=0;
        for(int i=1;i<=n;++i){
            int stepCount= costs[i-1];
        for (int j = Math.max(0, i - 3); j < i; ++j) {
        dp[i] = Math.min(dp[i], dp[j] + costs[i - 1] + (i - j)*(i-j));          
          }
        } 
        return dp[n];
    }
}
