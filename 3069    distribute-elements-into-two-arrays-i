class BinaryIndexedTree {
    private int size;
    private int[] tree;

    public BinaryIndexedTree(int size) {
        this.size = size;
        this.tree = new int[size + 1];
    }


    public void update(int x, int delta) {
        for (; x <= size; x += x & -x) {
            tree[x] += delta;
        }
    }

    public int query(int x) {
        int sum = 0;
        for (; x > 0; x -= x & -x) {
            sum += tree[x];
        }
        return sum;
    }
}
class Solution {
  
    public int[] resultArray(int[] nums) {
        int[] sortedNums = nums.clone();
        Arrays.sort(sortedNums);
        int n = sortedNums.length;
      
        BinaryIndexedTree tree1 = new BinaryIndexedTree(n + 1);
        BinaryIndexedTree tree2 = new BinaryIndexedTree(n + 1);
      
        tree1.update(Arrays.binarySearch(sortedNums, nums[0]) + 1, 1);
        tree2.update(Arrays.binarySearch(sortedNums, nums[1]) + 1, 1);
      
        int[] arr1 = new int[n];
        int[] arr2 = new int[n];
        arr1[0] = nums[0];
        arr2[0] = nums[1];
      
        int pointer1 = 1;
        int pointer2 = 1;
      
        for (int k = 2; k < n; ++k) {
            int compressedValue = Arrays.binarySearch(sortedNums, nums[k]) + 1;
          
            int greaterCount1 = pointer1 - tree1.query(compressedValue);
            int greaterCount2 = pointer2 - tree2.query(compressedValue);
          
            if (greaterCount1 > greaterCount2) {
                arr1[pointer1++] = nums[k];
                tree1.update(compressedValue, 1);
            } else if (greaterCount1 < greaterCount2) {
                arr2[pointer2++] = nums[k];
                tree2.update(compressedValue, 1);
            } else if (pointer1 <= pointer2) {
                arr1[pointer1++] = nums[k];
                tree1.update(compressedValue, 1);
            } else {
                arr2[pointer2++] = nums[k];
                tree2.update(compressedValue, 1);
            }
        }
      
        for (int k = 0; k < pointer2; ++k) {
            arr1[pointer1++] = arr2[k];
        }
      
        return arr1;
    }
}
